    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst separator = '\\n\\n***\\n***\\n***\\n\\n';\nlet combinedText = ''\n\nresponses.forEach((response, index) => {\n  const content = response.json.text || '';\n  \n  if (index === 0) {\n    combinedText += content;\n  } else {\n    combinedText += `${separator}${content}`;\n  }\n});\n\nreturn {\n  text: combinedText\n};"
      },
